  m_Script: {fileID: 11500000, guid: 470f20d322fca1144960e00d98847642, type: 3}
  m_Name: Sub_DDCG_1
  m_EditorClassIdentifier: Assembly-CSharp::SRTCourseData
  seoUrl: dai-dao-chi-gian-phong-thuy-co-hoc-i
  srtEntries:
  - Start: 0.2
    End: 1.56
    Text: "Kh\xF3a h\u1ECDc \u0110\u1EA1i \u0110\u1EA1o Ch\xED Gi\u1EA3n"
  - Start: 1.88
    End: 2.94
    Text: "Phong Th\u1EE7y C\u1ED5 H\u1ECDc I"
  - Start: 2.94
    End: 5.94
    Text: "mang \u0111\u1EBFn cho b\u1EA1n m\u1ED9t c\u01A1 h\u1ED9i hi\u1EBFm c\xF3
      \u0111\u1EC3 t\xECm hi\u1EC3u"
  - Start: 5.94
    End: 7.64
    Text: "v\xE0 th\u1EF1c h\xE0nh ngh\u1EC7 thu\u1EADt phong th\u1EE7y"
  - Start: 7.64
    End: 9.04
    Text: "m\u1ED9t l\u0129nh v\u1EF1c \u0111a chi\u1EC1u"
  - Start: 9.04
    End: 10.86
    Text: "s\xE2u s\u1EAFc trong n\u1EC1n v\u0103n h\xF3a \xC1 \u0110\xF4ng"
  - Start: 11.62
    End: 13.72
    Text: "d\u01B0\u1EDBi s\u1EF1 h\u01B0\u1EDBng d\u1EABn c\u1EE7a Phong Th\u1EE7y
      S\u01B0"
  - Start: 13.72
    End: 16.72
    Text: "Th\u1EA1c s\u0129, nghi\xEAn c\u1EE9u sinh, Qu\u1EA3n l\xFD kinh t\u1EBF"
  - Start: 16.72
    End: 18.74
    Text: "Phong Th\u1EE7y S\u01B0 Qu\u1ED1c T\u1EBF Nguy\u1EC5n Tr\u1ECDng M\u1EA1nh"
  - Start: 18.74
    End: 21.74
    Text: "m\u1ED9t trong nh\u1EEFng chuy\xEAn gia h\xE0ng \u0111\u1EA7u trong l\u0129nh
      v\u1EF1c n\xE0y"
  - Start: 21.74
    End: 24.74
    Text: "b\u1EA1n s\u1EBD kh\xE1m ph\xE1 ra nh\u1EEFng b\xED quy\u1EBFt v\xE0 k\u1EF9
      thu\u1EADt \u0111\u1EC3 \xE1p d\u1EE5ng"
  - Start: 24.74
    End: 27.74
    Text: " Phong th\u1EE7y v\xE0o cu\u1ED9c s\u1ED1ng h\xE0ng ng\xE0y c\u1EE7a m\xECnh."
  srtAsset: {fileID: 4900000, guid: 6cc51cfe97699134bbbc4bb0cd0cac2b, type: 3}
