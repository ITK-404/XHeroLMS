# ============================================
# Unity.gitignore (Full & Optimized Version)
# https://github.com/github/gitignore/blob/main/Unity.gitignore
# Custom version updated for large project handling
# ============================================

# build temp / junk
.tmp/
**/.tmp/
**/RelWithDebInfo/
**/arm64-v8a/

Recordings/
**/Recordings/

# Addressables build output
ServerData/
**/*.bundle
**/*.hash

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/
/[Ss]amples/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Crash Reports
sysinfo.txt

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated files on crash reports
*.pidb
*.pdb
*.mdb

# Build results
*.apk
*.aab
*.unitypackage
*.ipa

# Addressables
[Aa]ssets/**/AddressableAssetsData/*/Build*/
[Aa]ssets/**/AddressableAssetsData/*/aa/*

# Visual Studio / Rider / JetBrains
.vs/
.idea/
.consulo/
.vscode/

ExportedObj/
[Aa]ssets/Plugins/Editor/JetBrains*
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.booproj
*.svd
*.opendb
*.VC.db

# Gradle cache directory
.gradle/

# Logs
*.log
*.stacktrace

# Cache & generated data
/[Cc]ache/
*.tmp
*.bak
*.old

# ========== Package Manager ==========
Packages/com.unity.package-manager.cache/

# ========== Plastic SCM ==========
.plastic/
*.plastic

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# ========== Lock files ==========
*.lock
*.swp
*.swo

# Ignore LFS large binaries (handled separately)
*.mov
*.7z
*.iso
*.exr
*.rar
*.zip

# Ignore LFS large Firebase binaries
Assets/Firebase/Plugins/x86_64/*.bundle
Assets/Firebase/Plugins/x86_64/*.so

# Ignore Data Cloud
Assets/Editor/GCS/*.json
# Ignore all files starting with "google" in StreamingAssets
Assets/StreamingAssets/google*
# Ignore all files starting with "google" in Firebase
Assets/Firebase/[Gg]oogle*

#Ignore Auticator Key
Assets/Editor/Authenticator/*

# ============================================
# End of Unity.gitignore
# ============================================